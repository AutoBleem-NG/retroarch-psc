    wl->relative_pointer_manager  = NULL;
    wl->pointer_constraints       = NULL;
@@ -422,10 +483,15 @@ void gfx_ctx_wl_update_title_common(void *data)
       {
          if (title[0])
          {
-            if (wl->deco)
-               zxdg_toplevel_decoration_v1_set_mode(wl->deco,
-                     ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
-            xdg_toplevel_set_title(wl->xdg_toplevel, title);
+            if (wl->xdg_toplevel)
+            {
+               if (wl->deco)
+                  zxdg_toplevel_decoration_v1_set_mode(wl->deco,
+                        ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
+               xdg_toplevel_set_title(wl->xdg_toplevel, title);
+            }
+            else if (wl->wl_shell_surface)
+               wl_shell_surface_set_title(wl->wl_shell_surface, title);
          }
       }
    }
@@ -774,11 +840,13 @@ bool gfx_ctx_wl_init_common(
       return false;
    }
 
-   if (!wl->xdg_shell)
+   if (!wl->xdg_shell && !wl->wl_shell)
    {
       RARCH_ERR("[Wayland] Failed to create shell.\n");
       return false;
    }
+   if (!wl->xdg_shell)
+      RARCH_WARN("[Wayland] xdg_shell unavailable; falling back to deprecated wl_shell.\n");
 
